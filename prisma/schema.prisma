generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT

  @@map("user_role")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED

  @@map("project_status")
}

enum EstimateItemStatus {
  DRAFT
  AGREED

  @@map("estimate_item_status")
}

enum ActStatus {
  DRAFT
  SENT
  SIGNED

  @@map("act_status")
}

enum ExtraWorkStatus {
  PENDING
  AGREED
  REJECTED

  @@map("extra_work_status")
}

enum FileTab {
  TZ
  ESTIMATE
  RECEIPTS
  ACTS
  EXTRA_WORKS
  PHOTOS

  @@map("file_tab")
}

enum PhotoAlbum {
  BEFORE
  PROCESS
  AFTER
  HIDDEN

  @@map("photo_album")
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE

  @@map("activity_action")
}

enum ProjectInflowPurpose {
  WORKS
  MATERIALS

  @@map("project_inflow_purpose")
}

enum WalletType {
  WORKS
  MATERIALS

  @@map("wallet_type")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client          Client?
  managedProjects   Project[]     @relation("ProjectManager")
  tzUpdatedProjects Project[]     @relation("ProjectTzUpdatedBy")
  uploadedFiles     File[]
  activityLogs      ActivityLog[]
  sessions        Session[]
  accounts        Account[]
  addedPayments   Payment[]     @relation("PaymentAddedBy")
  addedInflows    ProjectInflow[] @relation("InflowAddedBy")
  addedTransfers  WalletTransfer[] @relation("TransferAddedBy")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("user")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Account {
  id                     Int       @id @default(autoincrement())
  userId                 Int
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId              String
  providerId             String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  expiresAt              DateTime?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model RateLimit {
  id          Int    @id @default(autoincrement())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([key])
  @@map("rate_limit")
}

model Client {
  id          Int     @id @default(autoincrement())
  fullName    String
  phone       String?
  email       String?
  userId      Int?    @unique
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  inviteToken String? @unique @map("invite_token")

  projects Project[]

  @@index([fullName])
  @@index([userId])
  @@map("client")
}

model Project {
  id        Int           @id @default(autoincrement())
  clientId  Int
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number    String
  name      String
  address   String
  status    ProjectStatus @default(PLANNING)
  startDate DateTime?
  managerId       Int
  manager         User          @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  tzText          String?
  tzUpdatedAt     DateTime?     @map("tz_updated_at")
  tzUpdatedById   Int?          @map("tz_updated_by_id")
  tzUpdatedBy     User?         @relation("ProjectTzUpdatedBy", fields: [tzUpdatedById], references: [id], onDelete: SetNull)
  updatedAt       DateTime      @updatedAt

  estimateSections EstimateSection[]
  receipts         Receipt[]
  acts             Act[]
  extraWorks       ExtraWork[]
  inflows          ProjectInflow[]
  walletTransfers  WalletTransfer[]
  files            File[]
  activityLogs     ActivityLog[]

  @@index([clientId])
  @@index([number])
  @@index([status])
  @@index([managerId])
  @@index([tzUpdatedById])
  @@index([updatedAt])
  @@map("project")
}

model EstimateSection {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int

  items    EstimateItem[]
  receipts Receipt[]
  files    File[]

  @@index([projectId])
  @@index([sortOrder])
  @@map("estimate_section")
}

model EstimateItem {
  id                Int                @id @default(autoincrement())
  sectionId         Int
  section           EstimateSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder         Int
  name              String
  unit              String
  quantity          Decimal            @db.Decimal(12, 3)
  unitPrice         Decimal            @db.Decimal(12, 2)
  comment           String?
  status            EstimateItemStatus @default(DRAFT)
  isVisibleToClient Boolean            @default(true)

  actItems ActItem[]

  @@index([sectionId])
  @@index([sortOrder])
  @@index([status])
  @@index([isVisibleToClient])
  @@map("estimate_item")
}

model Receipt {
  id                Int              @id @default(autoincrement())
  projectId         Int
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  estimateSectionId Int?
  estimateSection   EstimateSection? @relation(fields: [estimateSectionId], references: [id], onDelete: SetNull)
  date              DateTime
  title             String
  amountDue         Decimal          @db.Decimal(12, 2)
  comment           String?

  payments Payment[]
  files    File[]

  @@index([projectId])
  @@index([estimateSectionId])
  @@index([date])
  @@map("receipt")
}

model Payment {
  id        Int      @id @default(autoincrement())
  receiptId Int
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Decimal  @db.Decimal(12, 2)
  comment   String?
  addedById Int
  addedBy   User     @relation("PaymentAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  files File[]

  @@index([receiptId])
  @@index([date])
  @@index([addedById])
  @@map("payment")
}

model Act {
  id        Int       @id @default(autoincrement())
  projectId Int
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    String
  date      DateTime
  stage     String?
  status    ActStatus @default(DRAFT)
  comment   String?

  items ActItem[]
  files File[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([date])
  @@index([status])
  @@map("act")
}

model ActItem {
  id             Int          @id @default(autoincrement())
  actId          Int
  act            Act          @relation(fields: [actId], references: [id], onDelete: Cascade)
  estimateItemId Int
  estimateItem   EstimateItem @relation(fields: [estimateItemId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(12, 2)

  @@unique([estimateItemId])
  @@index([actId])
  @@map("act_item")
}

model ExtraWork {
  id                Int             @id @default(autoincrement())
  projectId         Int
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date              DateTime
  description       String
  unit              String
  quantity          Decimal         @db.Decimal(12, 3)
  unitPrice         Decimal         @db.Decimal(12, 2)
  status            ExtraWorkStatus @default(PENDING)
  isVisibleToClient Boolean         @default(false)
  includedInBudget  Boolean         @default(false)

  files File[]

  @@index([projectId])
  @@index([date])
  @@index([status])
  @@index([isVisibleToClient])
  @@map("extra_work")
}

model ProjectInflow {
  id        Int                  @id @default(autoincrement())
  projectId Int
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Decimal              @db.Decimal(12, 2)
  purpose   ProjectInflowPurpose
  comment   String?
  addedById Int
  addedBy   User                 @relation("InflowAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([date])
  @@index([addedById])
  @@map("project_inflow")
}

model WalletTransfer {
  id         Int        @id @default(autoincrement())
  projectId  Int
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Decimal    @db.Decimal(12, 2)
  fromWallet WalletType
  toWallet   WalletType
  comment    String?
  addedById  Int
  addedBy    User       @relation("TransferAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([date])
  @@index([addedById])
  @@map("wallet_transfer")
}

model File {
  id                Int              @id @default(autoincrement())
  projectId         Int
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tab               FileTab
  receiptId         Int?
  receipt           Receipt?         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  paymentId         Int?
  payment           Payment?         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actId             Int?
  act               Act?             @relation(fields: [actId], references: [id], onDelete: Cascade)
  extraWorkId       Int?
  extraWork         ExtraWork?       @relation(fields: [extraWorkId], references: [id], onDelete: Cascade)
  estimateSectionId Int?
  estimateSection   EstimateSection? @relation(fields: [estimateSectionId], references: [id], onDelete: Cascade)
  storageKey        String
  originalName      String
  mimeType          String
  size              Int
  uploadedById      Int
  uploadedBy        User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt        DateTime         @default(now())
  isPhoto           Boolean          @default(false)
  caption           String?
  album             PhotoAlbum?
  isVisibleToClient Boolean          @default(true)

  @@index([projectId])
  @@index([tab])
  @@index([receiptId])
  @@index([paymentId])
  @@index([actId])
  @@index([extraWorkId])
  @@index([estimateSectionId])
  @@index([uploadedById])
  @@index([uploadedAt])
  @@index([isPhoto])
  @@index([album])
  @@map("file")
}

model ActivityLog {
  id         Int            @id @default(autoincrement())
  userId     Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  projectId  Int?
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityType String
  entityId   Int
  action     ActivityAction
  changes    Json?
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_log")
}
