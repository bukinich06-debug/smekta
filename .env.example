# Database connection string for PostgreSQL
# Example: postgresql://user:password@localhost:5432/smekta?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/smekta?schema=public"

# Better Auth configuration
# Secret key for signing tokens (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-secret-key-here"
# Base URL of the application (server-side)
BETTER_AUTH_URL="http://localhost:3000"
# Base URL of the application (client-side)
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Vercel Blob (file uploads for receipts and other attachments)
BLOB_READ_WRITE_TOKEN=""
